{
  "name": "strtok3",
  "version": "10.8.0",
  "description": "A promise based streaming tokenizer",
  "author": {
    "name": "Borewit",
    "url": "https://github.com/Borewit"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/Borewit"
  },
  "scripts": {
    "clean": "del-cli 'lib/**/*.js' 'lib/**/*.js.map' 'lib/**/*.d.ts' 'test/**/*.js' 'test/**/*.js.map'",
    "compile-src": "tsc -p lib  --sourceMap false",
    "compile-src:dev": "tsc -p lib --sourceMap --inlineSources",
    "compile-test": "tsc -p test",
    "compile": "yarn run compile-src && yarn run compile-test && yarn run test:types",
    "build": "yarn run clean && yarn run compile",
    "build:dev": "yarn run clean && yarn run compile-test && yarn run compile-src:dev && yarn run test:types",
    "prepublishOnly": "yarn run build",
    "lint:ts": "yarn run lint",
    "lint": "biome check",
    "fix": "biome check --write",
    "test": "mocha",
    "test:types": "tsc -p test/types && tsc -p test/types/tsconfig.browser.json",
    "bun:test": "bun run --bun test",
    "test-coverage": "c8 yarn run test",
    "start": "yarn run compile && yarn run lint && yarn run cover-test",
    "update-biome": "yarn add -D --exact @biomejs/biome && npx @biomejs/biome migrate --write",
    "lint:ts:fix": "yarn run fix",
    "deps:refresh": "yarn up -R '**' && yarn dedupe"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Borewit/strtok3.git"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "node": "./lib/index.js",
      "default": "./lib/core.js"
    },
    "./core": "./lib/core.js"
  },
  "types": "lib/index.d.ts",
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts"
  ],
  "bugs": {
    "url": "https://github.com/Borewit/strtok3/issues"
  },
  "dependencies": {
    "@tokenizer/token": "^0.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@types/chai": "^5.2.3",
    "@types/chai-as-promised": "^8.0.2",
    "@types/debug": "^4.1.13",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.5",
    "c8": "^12.0.0",
    "chai": "^6.3.0",
    "chai-as-promised": "^8.0.2",
    "del-cli": "^8.0.1",
    "mocha": "^11.8.0",
    "node-readable-to-web-readable-stream": "^0.4.2",
    "token-types": "^6.2.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "uint8array-extras": "^1.6.0"
  },
  "keywords": [
    "tokenizer",
    "reader",
    "token",
    "async",
    "promise",
    "parser",
    "decoder",
    "binary",
    "endian",
    "uint",
    "stream",
    "streaming"
  ],
  "packageManager": "yarn@4.18.1"
}
